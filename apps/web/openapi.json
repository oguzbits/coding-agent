  "info": {
    "title": "coding-agent API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "alice@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AccountDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "emailConfirmed": {
            "type": "boolean",
            "description": "False until the link from the confirmation mail was used."
          }
        },
        "required": [
          "id",
          "email",
          "emailConfirmed"
        ]
      },
      "ConfirmEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "token"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200
          },
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "SettingsDto": {
        "type": "object",
        "properties": {
          "hasGeminiKey": {
            "type": "boolean"
          },
          "geminiKeyLast4": {
            "type": "string",
            "nullable": true,
            "description": "Last four characters; the key itself is never returned."
          },
          "modelName": {
            "type": "string",
            "nullable": true
          },
          "limits": {
            "type": "object",
            "properties": {
              "requestsPerMinute": {
                "type": "number",
                "nullable": true
              },
              "tokensPerMinute": {
                "type": "number",
                "nullable": true
              },
              "requestsPerDay": {
                "type": "number",
                "nullable": true
              }
            },
            "required": [
              "requestsPerMinute",
              "tokensPerMinute",
              "requestsPerDay"
            ]
          }
        },
        "required": [
          "hasGeminiKey",
          "geminiKeyLast4",
          "modelName",
          "limits"
        ]
      },
      "SetGeminiKeyDto": {
        "type": "object",
        "properties": {
          "apiKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "pattern": "^\\S+$"
          }
        },
        "required": [
          "apiKey"
        ]
      },
      "SetModelSettingsDto": {
        "type": "object",
        "properties": {
          "modelName": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[\\w./-]+$"
          },
          "requestsPerMinute": {
            "type": "number",
            "nullable": true,
            "minimum": 1,
            "maximum": 100000000
          },
          "tokensPerMinute": {
            "type": "number",
            "nullable": true,
            "minimum": 1,
            "maximum": 100000000
          },
          "requestsPerDay": {
            "type": "number",
            "nullable": true,
            "minimum": 1,
            "maximum": 100000000
          }
        }
      },
      "RunStartedEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "run_started"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "UserMessageEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "user_message"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ]
      },
      "AssistantMessageEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "assistant_message"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ]
      },
      "ToolCallEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "tool_call"
            ]
          },
          "callId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "args": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "type",
          "callId",
          "name",
          "args"
        ]
      },
      "ApprovalRequestedEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "approval_requested"
            ]
          },
          "callId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "args": {
            "type": "object",
            "additionalProperties": true
          },
          "preview": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "callId",
          "name",
          "args",
          "preview"
        ]
      },
      "ApprovalResolvedEventDto": {
