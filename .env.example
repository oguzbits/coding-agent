# Copy to apps/api/.env for local development. Real values never go into git.
# Defaults for everything except DATABASE_URL live in apps/api/src/config/env.validation.ts.

# Postgres from compose.yaml (npm run db:up)
DATABASE_URL=postgres://coding_agent:coding_agent@localhost:5432/coding_agent

# PORT=3000
# HOST=127.0.0.1
# LOG_LEVEL=log
# Comma-separated origins of the web app (also used for the Host and Origin check)
# ALLOWED_ORIGINS=http://localhost:5173
