# Template for apps/api/.env. `npm run env:init` creates that file and fills the empty secrets with random values.
# Real values never go into git. Defaults for everything optional live in apps/api/src/config/env.validation.ts.

# Postgres from compose.yaml (npm run db:up)
DATABASE_URL=postgres://coding_agent:coding_agent@localhost:5432/coding_agent

# Signs the session cookie (at least 32 characters)
SESSION_SECRET=
# Base64 of 32 random bytes; encrypts the users' Gemini keys. Losing it makes stored keys unreadable.
MASTER_KEY=

# Registration is closed by default (false); the first account can always be created.
# Open for local development; keep it closed on a public server.
REGISTRATION_OPEN=true
# Unconfirmed accounts can log in but not start a run. Mails go to the log until a mail provider is wired in.
# REQUIRE_EMAIL_CONFIRMATION=true
# CONFIRM_TOKEN_HOURS=24
# RESET_TOKEN_MINUTES=60
# Switches on GET /metrics (Prometheus). Scrapers send it as `Authorization: Bearer <token>`. Without it the endpoint is off.
# METRICS_TOKEN=
# Traces (OpenTelemetry, OTLP/HTTP). Off unless an endpoint is set; spans carry ids, names and counts, never content.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=coding-agent
# PORT=3000
# HOST=127.0.0.1
# LOG_LEVEL=log
# Comma-separated origins of the web app (also used for the Host and Origin check)
# ALLOWED_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (0 = none). Set it behind nginx/Caddy/a load balancer,
# otherwise all clients share one rate-limit bucket. Never set it without a proxy: clients could fake their address.
# TRUST_PROXY=0
# A run waiting this long for an approval is stopped (seconds)
# APPROVAL_TIMEOUT_SECONDS=1800
